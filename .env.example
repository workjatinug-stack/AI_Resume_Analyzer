# Database Configuration
DATABASE_URL=mysql://user:password@localhost:3306/resume_analyzer

# OAuth Configuration
VITE_APP_ID=your_app_id
OAUTH_SERVER_URL=https://oauth.example.com
OWNER_OPEN_ID=your_owner_open_id

# JWT Secret for session management
JWT_SECRET=your_jwt_secret_key_here

# Forge API Configuration (AI Service)
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=your_forge_api_key

# CORS Configuration (comma-separated list of allowed origins)
# For production: https://your-vercel-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend API URL (for Vercel frontend deployment)
# Set this to your deployed backend URL (e.g., https://your-backend.railway.app)
# If not set, frontend will try to use /api/trpc (relative path for local development)
VITE_BACKEND_URL=

# Frontend Environment Variables
VITE_OAUTH_PORTAL_URL=https://oauth.example.com
VITE_FRONTEND_FORGE_API_KEY=your_frontend_forge_api_key
VITE_FRONTEND_FORGE_API_URL=https://forge.example.com
